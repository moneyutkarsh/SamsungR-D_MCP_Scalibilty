# Local Development Environment Variables
# Copy this file to .env and modify as needed

# Environment identifier
ENVIRONMENT=local

# Model Backend Selection: mock | ollama | openai
MODEL_BACKEND=ollama

# Ollama Configuration (when running locally - Ollama in Docker)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Echo Tool URL (when running locally)
ECHO_TOOL_URL=http://localhost:8001

# OpenAI Configuration (if using OpenAI)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Log paths (relative to project root)
LOG_PATH=data/logs/agent_host.jsonl
TOOL_LOG_PATH=data/logs/tool_executor.jsonl
ECHO_LOG_PATH=data/logs/echo_tool.jsonl

{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(mcp_requests_total{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Average Workflow Depth",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(mcp_workflow_depth_count_sum{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}) / sum(mcp_workflow_depth_count_count{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"})) OR on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool Failure Rate (%)",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "((sum(rate(mcp_tool_recovery_total{status=\"failed\", model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m])) / sum(rate(mcp_requests_total{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m]))) * 100) OR on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Cost ($)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(mcp_cost_usd_total{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}) OR on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "System Throughput (RPS)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(mcp_requests_total{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latency Decomposition (Average per Component)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (component, transport) (rate(mcp_latency_ms_sum{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m])) / sum by (component, transport) (rate(mcp_latency_ms_count{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m]))",
          "legendFormat": "{{component}} - {{transport}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "End-to-End Latency Percentiles (P95 / P99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_latency_ms_bucket{component=\"total\", model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m])))",
          "legendFormat": "P95 Total",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mcp_latency_ms_bucket{component=\"total\", model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m])))",
          "legendFormat": "P99 Total",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cost per 1K Requests ($/1K)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "((sum(rate(mcp_cost_usd_total{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m])) / sum(rate(mcp_requests_total{model=~\"$model\", transport=~\"$transport\", workload=~\"$workload\", users=~\"$concurrency\"}[1m]))) * 1000) OR on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
